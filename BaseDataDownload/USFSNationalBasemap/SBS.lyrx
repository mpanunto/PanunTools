          "expression" : "def FindLabel ( [SITE_NAME] ):\n  import re\n  newlabel = re.sub(r\"\\([^()]*\\)\", \"\", [SITE_NAME])\n  if newlabel.endswith(\" BL\"):\n     S = newlabel.replace(\" BL\",\"\").replace(\"&\",\"and\")\n     S = S.title()\n     return \"<FNT name = 'ForestaTwoSmall' size = '10'>M</FNT>\" + \" \" + S\n  else:\n    S = newlabel.replace(\"BOAT RAMP/DAY USE\",\"\").replace(\" HUNT CAMP & BOAT RAMP\",\"\").replace(\"-BOAT RAMP\",\"\").replace(\"BOAT DOCKS\",\"\").replace(\"BOAT DOCK\",\"\").replace(\"BOAT LAUNCH COMPLEX\",\"\").replace(\"BOAT LAUNCH AREA\",\"\").replace(\"BOAT LAUNCH/TRAILHEAD\",\"\").replace(\"BOAT LAUNCH\",\"\").replace(\"BOAT LANDING\",\"\").replace(\"CANOE LAUNCH\",\"\").replace(\"RAFT LAUNCH\",\"\").replace(\"RAFT SITE\",\"\").replace(\"CARRY DOWN\",\"\").replace(\"PUT-IN/TAKE-OUT\",\"\").replace(\"(PUT-IN,TAKE-OUT)\",\"\").replace(\"(PUT-IN)\",\"\").replace(\"PUT-IN\",\"\").replace(\"CARRYIN ACCESS\",\"\").replace(\"CARRY-IN\",\"\").replace(\"CARRY IN\",\"\").replace(\"BOATER TAKEOUT\",\"\").replace(\"(TAKE-OUT)\",\"\").replace(\"TAKE-OUT\",\"\").replace(\"TAKEOUT\",\"\").replace(\"FLOATBOAT ACCESS\",\"\").replace(\"ATV BOAT ACCESS\",\"\").replace(\"BOAT ACCESS\",\"\").replace(\"/BOATING/PICNIC/TRHD\",\"\").replace(\" BOATING SITE\",\"\").replace(\" BOAT SITE\",\"\").replace(\" BOATING AREA\",\"\").replace(\" BOATING/PICNIC\",\"\").replace(\"BOATING AND DAY USE\",\"\").replace(\" BOATING\",\"\").replace(\" BOAT\",\"\").replace(\" DAY USE AREA\",\"\").replace(\" DISPERSED AREA\",\"\").replace(\" DISPERSED\",\"\").replace(\" DAY USE\",\"\").replace(\" @\",\"\").replace(\" KAYAK TRAIL\",\"\").replace(\" KAYAK LAUNCH\",\"\").replace(\" RIVER LAUNCH SITE\",\"\").replace(\" RIVER LAUNCH\",\"\").replace(\" CANOE & OHT TRAILHEAD\",\"\").replace(\" RIVER ACCESS SITE\",\"\").replace(\" RIVER ACCESS PARKING\",\"\").replace(\"ROAD CANOE ACCESS\",\"\").replace(\" RIVER ACCESS\",\"\").replace(\" CANOE ACCESS\",\"\").replace(\" PICNIC AND\",\"\").replace(\" RAFTING PUT IN\",\"\").replace(\" RAFT TAKE-OUT\",\"\").replace(\" RAFTING TAKE OUT\",\"\").replace(\" RAFTERS\",\"\").replace(\"LAUNCHING RAMP\",\"\").replace(\"RAMP\",\"\").replace(\"MARINA & STORE\",\"\").replace(\"MARINA\",\"\").replace(\"ACCESS\",\"\").replace(\"LAUNCH SITE\",\"\").replace(\"RECREATION AREA CAMPSITE AND\",\"\").replace(\" RECREATION AREA\",\"\").replace(\" AND BIKE TRAILHEAD\",\"\").replace(\"REC SITE\",\"\").replace(\" BS\",\"\").replace(\" CG\",\"\").replace(\"ANGLER PARKING\",\"\").replace(\" LAUNCH\",\"\").replace(\" REST STOP\",\"\").replace(\"BOAT RAMP\",\"\").replace(\"&\",\"and\")\n    S = S.title()\n    return \"<FNT name = 'ForestaTwoSmall' size = '10'>M</FNT>\" + \" \" + S",
          "expressionEngine" : "Python",
