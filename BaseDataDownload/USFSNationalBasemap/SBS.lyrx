        {
          "type" : "CIMLabelClass",
          "expression" : "def FindLabel ( [SITE_NAME] ):\n  import re\n  newlabel = re.sub(r\"\\([^()]*\\)\", \"\", [SITE_NAME])\n  if newlabel.endswith(\" TH\"):\n     S= newlabel.replace(\" TH\",\"\").replace(\"& ST.\",\"and St.\").replace(\"11&30\", \"11 and 30\").replace(\"&\",\"and\")\n     S= S.title()\n     return \"<FNT name = 'ForestaTwoSmall' size = '10'>t</FNT>\" + \" \" + S\n  else:\n    S = newlabel.replace(\"Trailhead\",\"\").replace(\" TRAILHEAD AND INTERPRETIVE SITE \",\"\").replace(\"TRAILHEAD AND  INTERPRETIVE SITE\",\"\").replace(\" TRAILHEAD AND SITE\",\"\").replace(\" TRAILHEAD/CG\",\"\").replace(\" TRAILHEAD/PICNIC AREA\",\"\").replace(\" HORSE AND SNOWMOBILE TRAILHEAD\",\"\").replace(\" HORSE TRAILHEAD\",\"\").replace(\" HORSE TRAILER PARKING\",\"\").replace(\"CANOE TRHD\",\"\").replace(\" HORSE TH\",\"\").replace(\"SCENIC AREA TRAILHEAD\",\"\").replace(\"SCENIC AREA\",\"\").replace(\"EQUESTRIAN TRAILHEAD\",\"\").replace(\" EQUESTRIAN\",\"\").replace(\"SNOWMOBILE TRAILHEAD & BOAT LAUNCH SITE\",\"\").replace(\"SNOWMOBILE & BIKING T.H.\",\"\").replace(\" OHV TRAILHEAD AND TRAIL\",\"\").replace(\"SNOWMOBILE TRAILHEAD\",\"\").replace(\" CROSS COUNTRY SKI TRAILHEAD\",\"\").replace(\" CC SKI TRAILHEAD\",\"\").replace(\"SKI TRAILHEAD\",\"\").replace(\"MOTORIZED TRAILHEAD\",\"\").replace(\"MOTORIZED\",\"\").replace(\"MOTORSPORT\",\"\").replace(\" INTERPETIVE TRAILHEAD\",\"\").replace(\"BIKE & OHV TRAILHEAD\",\"\").replace(\"OFF-ROAD BICYCLE TRAILHEAD\",\"\").replace(\"OFFROAD BICYCLE TRAILHEAD\",\"\").replace(\"BIKE TRAILHEAD\",\"\").replace(\"BIKE TRAIL\",\"\").replace(\" CYCLE\",\"\").replace(\"HIKING TRAILHEAD\",\"\").replace(\"HIKER TRAILHEAD\",\"\").replace(\"HIKERS TH\",\"\").replace(\"HIKER TH\",\"\").replace(\" OHV AREA TRAILHEAD\",\"\").replace(\" ORV AREA\",\"\").replace(\"HIKING AND SKI AREA\",\"\").replace(\" HIKING\",\"\").replace(\"CAMPGROUND/TRAILHEAD\",\"\").replace(\"NORDIC X-COUNTRY SKI TH\",\"\").replace(\" X-COUNTRY TRAILHEAD\",\"\").replace(\" X-CNTRY SKI\",\"\").replace(\" X-SKI TRAIL\",\"\").replace(\"(X-C SKI TRAIL)\",\"\").replace(\"ATV TRAILHEAD\",\"\").replace(\" ATV\",\"\").replace(\" X-C SKI\",\"\").replace(\"TRT TRAILHEAD\",\"\").replace(\" HORSE TRAIL HEAD\",\"\").replace(\" TRAILHEAD\",\"\").replace(\" (TRAILHEAD)\",\"\").replace(\"TRAIL HEAD\",\"\").replace(\" TRAIHEAD\",\"\").replace(\"TAILHEAD\",\"\").replace(\" TREILHEAD\",\"\").replace(\" -TRAILHEAD\",\"\").replace(\"TRAILHEAD\",\"\").replace(\" HORSE TRAIL\",\"\").replace(\"SKI TRAIL\",\"\").replace(\"NATURE TRAIL\",\"\").replace(\"AZ TRAIL @\",\"\").replace(\"PARKING @\",\"\").replace(\" TRAILS\",\"\").replace(\" - TRAIL RIDERS\",\"\").replace(\" - TRAIL\",\"\").replace(\" TRAIL\",\"\").replace(\" - CAMPGROUND\",\"\").replace(\" CAMPGROUND\",\"\").replace(\" HORSE CAMP\",\"\").replace(\" HORSECAMP\",\"\").replace(\" T.H. - NAC\",\"\").replace(\" T.H.\",\"\").replace(\" TH/PARKING\",\"\").replace(\" TH AND CG\",\"\").replace(\" TH & CAMP\",\"\").replace(\" TH & IS\",\"\").replace(\"(BR) OSV TH\",\"\").replace(\"BIKE TH\",\"\").replace(\"- TH\",\"\").replace(\" TH\",\"\").replace(\" T H\",\"\").replace(\" TRHD COMPLEX\",\"\").replace(\" TRHD\",\"\").replace(\" (hikers and bicycles only)\",\"\").replace(\" ORV\",\"\").replace(\" OHV AND HORSE\",\"\").replace(\" OHV AREA\",\"\").replace(\" OHV\",\"\").replace(\" (OHV)\",\"\").replace(\" (SWEET CREEK)\",\"\").replace(\" - ENTIAT\",\"\").replace(\" - WEN RV\",\"\").replace(\" STOCK\",\"\").replace(\" STOCK TH\",\"\").replace(\" CAMP CAMPING AREA\",\"\").replace(\" RECREATION AREA\",\"\").replace(\" STAGING AREA\",\"\").replace(\"LAUNCH SITE\",\"\").replace(\" REC. AREA\",\"\").replace(\" REC AREA\",\"\").replace(\" REC SITE\",\"\").replace(\" & SNO-PARK\",\"\").replace(\"/ SNO-PARK\",\"\").replace(\" INTERPRETIVE\",\"\").replace(\" INTERPRETATIVE\",\"\").replace(\" INTERPT\",\"\").replace(\" INTERP\",\"\").replace(\" DAY USE\",\"\").replace(\" WAYSIDE\",\"\").replace(\" STAGING\",\"\").replace(\"WALKING PATH\",\"\").replace(\"WALKING\",\"\").replace(\" SNOPARK\",\"\").replace(\" ORV/DAY USE\",\"\").replace(\" -TON\",\"\").replace(\" - METHOW\",\"\").replace(\" - MET\",\"\").replace(\" - CLE\",\"\").replace(\" PARKING LOTS\",\"\").replace(\" PARKING LOT\",\"\").replace(\"-WINTER PARKING AREA\",\"\").replace(\" PARKING AREA\",\"\").replace(\" PARKING COMPLEX\",\"\").replace(\" PARKING TRAILHEAD\",\"\").replace(\" PARKING\",\"\").replace(\"PARK AND SKI LOT\",\"\").replace(\"SNOWMOBILE\",\"\").replace(\"MOTORCYCLE\",\"\").replace(\"NATURE TRAIL\",\"\").replace(\" X-C\",\"\").replace(\" XC\",\"\").replace(\"-CPGD\",\"\").replace(\" P.L.\",\"\").replace(\" PICNIC/TH\",\"\").replace(\"& FALLS\",\"and FALLS\").replace(\"&\",\"\").replace(\"TRANSFER STATION\",\"\").replace(\"FISHING AREA\",\"\").replace(\"LITTLE COTTONWOOD CANYON\",\"LCC\").replace(\"&\",\"and\")\n    S = S.title()\n    return \"<FNT name = 'ForestaTwoSmall' size = '10'>t</FNT>\" + \" \" + S",
