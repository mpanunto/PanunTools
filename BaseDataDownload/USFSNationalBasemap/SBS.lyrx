        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "var name = $feature.BUILDING_NAME;\n\n// Chaining replaces\n\nname = replace(name, 'OFFICE DELTA CO SO', 'GRAND MESA-UNCOMPAHGRE-GUNNISON');\nname = replace(name, 'MT EMILY COMMUN BLDG (OLD)', 'ROUGE RIVER-SISKIYOU');\nname = Replace(name, \"FEDERAL BUILDING AAZ00045\", \"Coronado\");\nname = replace(name, 'CORVALLIS LAB & OFFICE','SIUSLAW');\nname = replace(name, 'OCHOCO NF SO, LOOKOUT MOUNTAIN RD OFFICE','OCHOCO');\nname = replace(name, 'ATRIUM BUILDING - OA AMS02535','National Forests in Mississippi');\nname = replace(name, 'WAYNE NATIONAL FOREST SO; ATHENS RANGER DISTRICT OFFICE','WAYNE');\nname = replace(name, \"EYNF SUPERVISOR'S OFFICE\", \"EL Yunque\");\nname = replace(name, 'OFFICE WENATCHEE WA NF SO AWA07186','OKANOGAN-WENATCHEE');\nname = replace(name, 'LIBBY SO AND D5 OFFICE','KOOTENAI');\nname = replace(name, 'OFFICE WENATCHEE WA NF SO AWA07186','WENATCHEE');\nname = Replace(name, 'BOZEMAN AMT02327', '');\nname = Replace(name, 'BASIN MANAGEMENT UNIT FOREST', '');\nname = Replace(name, 'GMFL', 'Green Mountain Finger Lakes');\nname = Replace(name, 'FRANCIS MARIAN &', 'FRANCIS MARION AND');\nname = Replace(name, 'OLYMPIA', 'OLYMPIC');\nname = replace(name, 'MBR NF SO LARAMIE WY','Medicine Bow-Routt');\nname = Replace(name, 'OFFICE DELTA CO SO', 'GMUG');\nname = Replace(name, 'UINTA-WASATCH-CACHE NATIONAL FOREST SUPERVISOR OFFICE', 'UINTA-WASATCH-CACHE');\nname = Replace(name, 'NATURAL RESOURCE CT-BOISE SO AID02216', 'BOISE');\nname = Replace(name, 'CARIBOU-TARGHEE NF SO COLLOCATION', 'CARIBOU-TARGHEE');\nname = Replace(name, 'KAMIAH SUPERVISORS OFFICE', '');\nname = Replace(name, 'NATIONAL FOREST SUPERVISORS OFFICE', '');\nname = Replace(name, 'NATIONAL FOREST SUPERVISOR S OFFICE', '');\nname = Replace(name, ' NATIONAL FORESTS', '');\nname = Replace(name, ' NATIONAL FOREST', '');\nname = replace(name, \"SUPERVISOR'S OFFICE\",\"\");\nname = replace(name, 'SUPERVISORS OFFICE','');\nname = Replace(name, 'SUPERVISOR S OFFICE', '');\nname = Replace(name, 'SUPERVISOR OFFICE', '');\nname = Replace(name, 'NATIONAL TALLGRASS PRAIRIE', '');\nname = Replace(name, 'GRASSLANDS SO OFFICE', '');\nname = Replace(name, 'NF SO, COLLOCATION W BLM', '');\nname = Replace(name, 'NF SO - NEW', '');\nname = Replace(name, 'NF SO', '');\nname = Replace(name, ' NF','');\nname = replace(name, 'SO & PSICC','');\nname = Replace(name, ' SO', '');\nname = Replace(name, 'NRA', '');\nname = Replace(name, 'NSA', '');\nname = replace(name, 'LAB/OFFICE','');\nname = Replace(name, 'OFFICE','');\n\n// Trim extra spaces caused by deletions\nreturn Trim(name);",
