    {
      "type" : "CIMFeatureLayer",
      "name" : "USFS Recreation",
      "uRI" : "CIMPATH=main_map/usfs_recreation.json",
      "sourceModifiedTime" : {
        "type" : "TimeInstant",
        "start" : 978307200000
      },
      "metadataURI" : "CIMPATH=Metadata/d40710fdbee6d2eb2f13678eac7e66b0.xml",
      "useSourceMetadata" : false,
      "description" : "A recreation site is a discrete area on a Forest that provides recreation opportunities, receives recreational use, and requires a management investment to operate and/or maintain to standard under the direction of an administrative unit in the National Forest System. Recreation sites range in development from relatively undeveloped areas, with little to no improvements (Development Scale 0 and 1), to concentrations of facilities and services evidencing a range of amenities and investment (Development Scale 2 through 5).",
      "layerElevation" : {
        "type" : "CIMLayerElevationSurface",
        "elevationSurfaceLayerURI" : "CIMPATH=Map/46f346de994d427a9eae0aff7c8c2544.json"
      },
      "layerType" : "Operational",
      "showLegends" : true,
      "visibility" : true,
      "displayCacheType" : "Permanent",
      "maxDisplayCacheAge" : 5,
      "showPopups" : true,
      "serviceLayerID" : -1,
      "refreshRate" : -1,
      "refreshRateUnit" : "esriTimeUnitsSeconds",
      "blendingMode" : "Alpha",
      "allowDrapingOnIntegratedMesh" : true,
      "autoGenerateFeatureTemplates" : true,
      "featureElevationExpression" : "0",
      "featureTable" : {
        "type" : "CIMFeatureTable",
        "definitionExpression" : "((SITE_TYPE IN ('CAMPGROUND', 'GROUP CAMPGROUND', 'TRAILHEAD', 'SKI AREA ALPINE', 'SKI AREA NORDIC', 'SNOWPARK', 'SNOWPLAY AREA') Or (SITE_TYPE IN ('PICNIC SITE', 'GROUP PICNIC SITE', 'INTERPRETIVE VISITOR CENTER (MAJOR)', 'INTERPRETIVE SITE (ADMIN)', 'INTERPRETIVE SITE', 'INTERPRETIVE VISITOR CENTER (MINOR)', 'BOATING SITE') And DEVELOPMENT_SCALE IN ('5', '4', '3', '2'))) And OPERATIONAL_STATUS = 'OPEN' And IMPROVEMENT_OWNERSHIP IN ('FOREST RESEARCH (FS)', 'NATIONAL FOREST (FS)')) \r\n\nOr (REGION = '10' And SITE_TYPE IN ('HOTEL, LODGE, RESORT', 'LOOKOUT/CABIN', 'RECREATION RESIDENCE')And OPERATIONAL_STATUS = 'OPEN' And IMPROVEMENT_OWNERSHIP IN ('FOREST RESEARCH (FS)', 'NATIONAL FOREST (FS)'))",
        "definitionExpressionName" : "Query 2",
        "definitionFilterChoices" : [
          {
            "type" : "CIMDefinitionFilter",
            "name" : "Query 1",
            "definitionExpression" : "SITE_TYPE IN ('CAMPGROUND', 'GROUP CAMPGROUND', 'GROUP PICNIC SITE', 'INTERPRETIVE VISITOR CENTER (MAJOR)', 'SKI AREA ALPINE', 'SKI AREA NORDIC', 'SNOWPARK', 'SNOWPLAY AREA', 'INTERPRETIVE VISITOR CENTER (MINOR)', 'TRAILHEAD') Or (SITE_TYPE IN ('PICNIC SITE', 'BOATING SITE', 'INTERPRETIVE SITE') And DEVELOPMENT_SCALE IN ('5', '4', '3', '2'))"
          },
          {
            "type" : "CIMDefinitionFilter",
            "name" : "Query 2",
            "definitionExpression" : "((SITE_TYPE IN ('CAMPGROUND', 'GROUP CAMPGROUND', 'TRAILHEAD', 'SKI AREA ALPINE', 'SKI AREA NORDIC', 'SNOWPARK', 'SNOWPLAY AREA') Or (SITE_TYPE IN ('PICNIC SITE', 'GROUP PICNIC SITE', 'INTERPRETIVE VISITOR CENTER (MAJOR)', 'INTERPRETIVE SITE (ADMIN)', 'INTERPRETIVE SITE', 'INTERPRETIVE VISITOR CENTER (MINOR)', 'BOATING SITE') And DEVELOPMENT_SCALE IN ('5', '4', '3', '2'))) And OPERATIONAL_STATUS = 'OPEN' And IMPROVEMENT_OWNERSHIP IN ('FOREST RESEARCH (FS)', 'NATIONAL FOREST (FS)')) \n\nOr (REGION = '10' And SITE_TYPE IN ('HOTEL, LODGE, RESORT', 'LOOKOUT/CABIN', 'RECREATION RESIDENCE')And OPERATIONAL_STATUS = 'OPEN' And IMPROVEMENT_OWNERSHIP IN ('FOREST RESEARCH (FS)', 'NATIONAL FOREST (FS)'))"
