    },
    {
      "type" : "CIMBinaryReference",
      "uRI" : "CIMPATH=Metadata/77bc05a134775524a2b93f223e34eda2.xml",
      "data" : "<?xml version=\"1.0\"?>\r\n<metadata xml:lang=\"en\">\r\n\t<Esri>\r\n\t\t<CreaDate>20230503</CreaDate>\r\n\t\t<CreaTime>08025900</CreaTime>\r\n\t\t<ArcGISFormat>1.0</ArcGISFormat>\r\n\t\t<SyncOnce>TRUE</SyncOnce>\r\n\t</Esri>\r\n\t<dataIdInfo>\r\n\t\t<idCitation>\r\n\t\t\t<resTitle>PLSS First Division BLM</resTitle>\r\n\t\t</idCitation>\r\n\t\t<idAbs>The PLSS First Division is commonly the section. This is the first set of divisions for a PLSS Township.</idAbs>\r\n\t\t<idCredit>FGDC Cadastral Subcommittee</idCredit>\r\n\t</dataIdInfo>\r\n</metadata>\r\n"
    },
    {
      "type" : "CIMBinaryReference",
