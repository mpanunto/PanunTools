          "expression" : "def FindLabel ( [SITE_NAME] ):\n  import re\n  newlabel = re.sub(r\"\\([^()]*\\)\", \"\", [SITE_NAME])\n  if newlabel.endswith(\" SP\"):\n    S = newlabel.replace(\" SP\",\"\")\n    S = S.title()\n    return \"<FNT name = 'ForestaTwoSmall' size = '10'>G</FNT>\" + \" \" + S\n  elif newlabel.endswith(\" TH\"):\n    S =  newlabel.replace(\" TH\",\"\").replace(\"&\",\"and\")\n    S = S.title()\n    return \"<FNT name = 'ForestaTwoSmall' size = '10'>G</FNT>\" + \" \" + S\n  else:\n    S = newlabel.replace(\"SNO-PARK & CAMPGROUND\",\"\").replace(\"WINTER SNOWPARK\",\"\").replace(\"WINTER REC SITE\",\"\").replace(\"SNOWPARK\",\"\").replace(\"SNOW/TRAILHEAD\",\"\").replace(\"SNOW TH\",\"\").replace(\"SNOW PARK\",\"\").replace(\"SNOW-PARK\",\"\").replace(\"SNOPARK/TRAILHEAD\",\"\").replace(\"SNOPARK\",\"\").replace(\"SNOWPLAY AREA\",\"\").replace(\"SNOW PLAY AREA\",\"\").replace(\"SNOPLAY AREA\",\"\").replace(\"SNO-PLAY AREA\",\"\").replace(\"SNO-PARK TRAILHEAD\",\"\").replace(\"SNOWMOBILE PARK\",\"\").replace(\"SNOWMOBILE SHELTER\",\"\").replace(\"SNOWMOBILE TH\",\"\").replace(\"SNOWMOBILE AREA\",\"\").replace(\"SNOWMOBILE\",\"\").replace(\"SNO-PARK\",\"\").replace(\"CROSS COUNTRY SKI AREA\",\"\").replace(\" SKI TOURING WINTER\",\"\").replace(\" SKI HILL\",\"\").replace(\" SKI BOWL\",\"\").replace(\" X-C SKI TH\",\"\").replace(\" X-C SKI\",\"\").replace(\" XC SKI AREA\",\"\").replace(\"-SKI AREA\",\"\").replace(\" SKI AREA\",\"\").replace(\" X/C SNO PARK\",\"\").replace(\"SNO PARK\",\"\").replace(\"STAGING AREA\",\"\").replace(\"SLIDING AREA\",\"\").replace(\"SNO-PARK TRAILHEAD\",\"\").replace(\"TRAILHEAD & SNOW PLAY\",\"\").replace(\"INFORMATION SITE/TRAILHEAD\",\"\").replace(\"AND OHV TRAILHEAD\",\"\").replace(\"TRAILHEAD\",\"\").replace(\"PARKING AREA\",\"\").replace(\"PARK AND SKI LOT\",\"\").replace(\"XC SKI AREA\",\"\").replace(\"CROSS COUNTRY SKIING\",\"\").replace(\"CROSS COUNTRY SKI\",\"\").replace(\"X-COUNTRY SITE\",\"\").replace(\"DAY USE AREA\",\"\").replace(\"DAY USE\",\"\").replace(\"WARMING SHELTER\",\"\").replace(\"WARMING HUT\",\"\").replace(\"NORDIC CENTER\",\"\").replace(\"NORDIC PARKING\",\"\").replace(\"SKI PARKING\",\"\").replace(\"NORDIC\",\"\").replace(\"(IM) OSV TH\",\"\").replace(\"WINTER STAGING\",\"\").replace(\"GROUP AREA\",\"\").replace(\"RECREATION AREA\",\"\").replace(\"REC SITE\",\"\").replace(\"SNO314G & SNO314E\",\"\").replace(\"SNO314H\",\"\").replace(\"SNO336 & SNO336B\",\"\").replace(\"&\",\"and\")\n    S = S.title()\n    return \"<FNT name = 'ForestaTwoSmall' size = '10'>G</FNT>\" + \" \" + S",
