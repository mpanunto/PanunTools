          "type" : "CIMExpressionInfo",
          "title" : "Custom",
          "expression" : "// Combine four fields into a single unique string\n// Replace Field1, Field2, Field3, Field4 with your actual field names\n\nvar f1 = $feature.route_type;\nvar f2 = $feature.funcclass;\nvar f3 = $feature.symbol_code;\nvar f4 = $feature.Generalization;\n\n// Convert nulls to empty strings to avoid \"null\" text\nif (IsEmpty(f1)) { f1 = \"E\" }\nif (IsEmpty(f2)) { f2 = \"E\" }\nif (IsEmpty(f3)) { f3 = \"E\" }\nif (IsEmpty(f4)) { f4 = \"E\" }\n\n// Create a unique value by concatenating with a separator\n// You can change \"-\" to \"_\" or any other separator\nreturn f1 + \"-\" + f2 + \"-\" + f3 + \"-\" + f4;",
          "returnType" : "Default"
        },
