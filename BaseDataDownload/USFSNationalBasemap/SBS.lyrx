        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "// Replace R1-R10 followed by ', ' with an empty string\nvar name = $feature.ADMIN_ORG_NAME;\n\nname = Replace(name, 'R1, ', '');\nname = Replace(name, 'R2, ', '');\nname = Replace(name, 'R3, ', '');\nname = Replace(name, 'R4, ', '');\nname = Replace(name, 'R5, ', '');\nname = Replace(name, 'R6, ', '');\nname = Replace(name, 'R8, ', '');\nname = Replace(name, 'R9, ', '');\nname = Replace(name, 'R10, ', '');\n\n// Trim removes leading.trailing spaces if left over\nreturn Trim(name);",
          "expressionEngine" : "Arcade",
          "featuresToLabel" : "AllVisibleFeatures",
