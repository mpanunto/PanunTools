          "expression" : "def FindLabel ( [poiname]  ):\n  import re\n  newlabel = re.sub(r\"\\([^()]*\\)\", \"\", [poiname]  )\n  S = newlabel.replace(\"Backcountry Vehicle Campsite\",\"\").replace(\"Backcountry Campsite\",\"\").replace(\"Wilderness Campsite\",\"\").replace(\"Boat-In Campsite\",\"\").replace(\"Primitive Campground\",\"\").replace(\"Backcountry Campground\",\"\").replace(\"NFCS - \",\"\").replace(\"Group Campsite\",\"\").replace(\"&\", \"and\")\n  S = S.title()\n  return \"<FNT name = 'ForestaTwoSmall' size = '10'>=</FNT>\" + \" \" + S",
