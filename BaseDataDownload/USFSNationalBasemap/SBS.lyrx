          "expression" : "def FindLabel ( [SITE_NAME] ):\n  import re\n  newlabel = re.sub(r\"\\([^()]*\\)\", \"\", [SITE_NAME])\n  if newlabel.endswith(\" PA\"):\n    S = newlabel.replace(\" PA\",\"\").replace(\"&\",\"and\")\n    S = S.title()\n    return \"<FNT name = 'ForestaTwoSmall' size = '10'>P</FNT>\" + \" \" + S\n  else:\n    S = newlabel.replace(\"DAY USE & BOAT LAUNCH\",\"\").replace(\"GROUP PICNIC SITE\",\"\").replace(\"GROUP RESERVATION PICNIC GROUND\",\"\").replace(\"AND PICNIC GROUND\",\"\").replace(\"PICNIC SITES\",\"\").replace(\"PICNIC SITE\",\"\").replace(\"PICNIC SHELTERS\",\"\").replace(\"PICNIC SHELTER\",\"\").replace(\"PICNIC/FISHING\",\"\").replace(\"VIEW POINT / PICNIC AREA\",\"\").replace(\"PICNIC AND PAVILION\",\"\").replace(\"PICNIC AND BOAT LAUNCH\",\"\").replace(\"PICNIC GROUP\",\"\").replace(\"PICNIC GROUNDS\",\"\").replace(\"PICNIC GROUND\",\"\").replace(\"PICNIC AREA AND TRAILHEAD\",\"\").replace(\"DAY USE AND PICNIC AREA\",\"\").replace(\"-DAY USE AREA\",\"\").replace(\"-PICNIC AREA\",\"\").replace(\"PICNIC AREA\",\"\").replace(\" - PICNIC\",\"\").replace(\"PICNIC-F\",\"\").replace(\"PICNIC\",\"\").replace(\" REST STOP\",\"\").replace(\" REST AREA\",\"\").replace(\" DISPERSED\",\"\").replace(\" DISP AREA\",\"\").replace(\" RECREATION SITE\",\"\").replace(\" RECREATION AREA\",\"\").replace(\" REC. AREA\",\"\").replace(\" REC AREA\",\"\").replace(\"AREA COMPOSITE\",\"\").replace(\" AREA\",\"\").replace(\"P.G.\",\"\").replace(\" FAMILY PG.\",\"\").replace(\" PG & BOAT LAUNCH\",\"\").replace(\"GPA\",\"\").replace(\" PG\",\"\").replace(\" PS\",\"\").replace(\" - TON\",\"\").replace(\" INTERPRETIVE SITE\",\"\").replace(\"REC SITE, BL, IS\",\"\").replace(\"REC SITE\",\"\").replace(\"HISTORIC SITE\",\"\").replace(\" INTERPT. PARK\",\"\").replace(\" RESERVATION SITE\",\"\").replace(\" WAYSIDE REST\",\"\").replace(\" WAYSIDE PARK\",\"\").replace(\" WAYSIDE\",\"\").replace(\"& TRAILHEAD\",\"\").replace(\"DAY-USE AREA\",\"\").replace(\"DAY USE 