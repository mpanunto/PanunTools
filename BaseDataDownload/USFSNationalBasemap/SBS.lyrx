        {
          "type" : "CIMLabelClass",
          "expression" : "def FindLabel ( [poiname]  ):\n  import re\n  newlabel = re.sub(r\"\\([^()]*\\)\", \"\", [poiname]  )\n  if newlabel.endswith(\" TH\"):\n    S = newlabel.replace(\"Ski Trails Trailhead\",\"\").replace(\"Ski Trailhead\",\"\").replace(\"Multi-Use Trailhead\",\"\").replace(\"Trail System Trailhead\",\"\").replace(\"Trailhead -\",\"\").replace(\"Trailhead\",\"\").replace(\"trailhead\",\"\").replace(\"TRAILHEAD\",\"\").replace(\"Trail Head\",\"\").replace(\" Trails\",\"\").replace(\"Trail\",\"\").replace(\" (hikers and bicycles only)\",\"\").replace(\" Barrier-Free Nature\",\"\").replace(\" Campground Loop\",\"\").replace(\" Visitor Center Mini-Loop\",\"\").replace(\" Campground\",\"\").replace(\" Nature\",\"\").replace(\"Ranger Station\",\"\").replace(\"TH\",\"\").replace(\"Ranger Stn\",\"\").replace(\"Day Use Area\",\"\").replace(\"Parking Lot\",\"\").replace(\"Parking Area\",\"\").replace(\" in Arboretum\",\"\").replace(\"Access\",\"\").replace(\"&\", \"and\")\n    S = S.title()\n    return \"<FNT name = 'ForestaTwoSmall' size = '10'>t</FNT>\" + \" \" + S\n  else:\n    S = newlabel.replace(\"Ski Trails Trailhead\",\"\").replace(\"Ski Trailhead\",\"\").replace(\"Multi-Use Trailhead\",\"\").replace(\"Trail System Trailhead\",\"\").replace(\"Trailhead -\",\"\").replace(\"Trailhead\",\"\").replace(\"trailhead\",\"\").replace(\"TRAILHEAD\",\"\").replace(\"Trail Head\",\"\").replace(\" Trails\",\"\").replace(\"/ Trail End\",\"\").replace(\"Trail\",\"\").replace(\" (hikers and bicycles only)\",\"\").replace(\" Barrier-Free Nature\",\"\").replace(\" Campground Loop\",\"\").replace(\" Visitor Center Mini-Loop\",\"\").replace(\" Campground\",\"\").replace(\" Nature\",\"\").replace(\"Ranger Station\",\"\").replace(\"TH\",\"\").replace(\"Ranger Stn\",\"\").replace(\"Day Use Area\",\"\").replace(\"Parking Lot\",\"\").replace(\"Parking Area\",\"\").replace(\" in Arboretum\",\"\").replace(\"Access\",\"\").replace(\"&\",\"and\")\n    S = S.title()\n    return \"<FNT name = 'ForestaTwoSmall' size = '10'>t</FNT>\" + \" \" + S",
          "expressionEngine" : "Python",
          "featuresToLabel" : "AllVisibleFeatures",
