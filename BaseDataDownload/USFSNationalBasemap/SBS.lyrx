      "labelClasses" : [
        {
          "type" : "CIMLabelClass",
          "expression" : "def FindLabel ( [FOREST_GRASSLANDNAME],[FORESTNAME] ):\n    P = [FOREST_GRASSLANDNAME].replace(\"National Forest\",\"NF\").replace(\"National Grassland\",\"NG\").replace(\"National Scenic Area\",\"NSA\").replace(\"National Recreation Area\",\"NRA\").replace(\"Management Unit\",\"MU\").replace(\"National Tallgrass Prairie\",\"NTP\").replace(\"&\",\"and\")\n    A = [FORESTNAME].replace(\"National Forest\",\"NF\").replace(\"National Grassland\",\"NG\").replace(\"National Scenic Area\",\"NSA\").replace(\"National Recreation Area\",\"NRA\").replace(\"Management Unit\",\"MU\").replace(\"National Tallgrass Prairie\",\"NTP\").replace(\"&\",\"and\")\n    if P==A:\n        return P\n    elif P is \"\":\n        return A\n    elif P.split(' ',1)[0] in A:\n        return \"<WRD spacing = '200'>\" + P + \"</WRD>\" + \"<CHR spacing = '0'><WRD spacing = '100'><FNT size = '7'>\" + \"(Admin As: \" + A + \")\" + \"</FNT></WRD></CHR>\"\n    else:\n        return \"<WRD spacing = '200'>\" + P + \"</WRD>\" + \"<CHR spacing = '0'><WRD spacing = '100'><FNT size = '7'>\" + \"(Admin By: \" + A + \")\" + \"</FNT></WRD></CHR>\"",
          "expressionEngine" : "Python",
          "featuresToLabel" : "AllVisibleFeatures",
          "maplexLabelPlacementProperties" : {
            "type" : "CIMMaplexLabelPlacementProperties",
            "featureType" : "Polygon",
