        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "var label_text = $feature.fet_name\n\nvar WordsToDelete = [' Day Use Area',' Natural Area',' Group Camping Site',' Group Use Area',' Group Use',' CAMPING SITES',' Campsite',' Camp Sites',' Group Site',' Campground Shelter',' Campground',' CAMPGROUND',' Horse Camp Recreation Site',' Horse Camp',' Recreation Site',' RECREATION SITE',' Recreation Area',' Rec Area',' RECREATION AREA',' Rec Site',' Rec. Site',' REC SITE',' Overflow Camp',' Camping Area',' Camp Area',' Camp',' Scenic Area',' Equestrian',' Primitive',' Contact Statio',' Guard Station',' Large Vehicle',' Small Vehicle',' - Aggregate',' Spectator Area',' SCENIC VIEW AREA',' Reservation',' - UMRBNM',' WSA',' CG','RV']\n\nfor (var i in WordsToDelete){\n  label_text = Replace(label_text, WordsToDelete[i],'');\n}\n\nif (Find('DesertUpper', label_text) != -1){label_text = Replace(label_text, 'DesertUpper', 'Desert Upper');\n}\n\nreturn Upper(label_text)",
          "expressionEngine" : "Arcade",
          "featuresToLabel" : "AllVisibleFeatures",
          "maplexLabelPlacementProperties" : {
            "type" : "CIMMaplexLabelPlacementProperties",
            "featureType" : "Point",
            "avoidPolygonHoles" : true,
            "canOverrunFeature" : true,
            "canPlaceLabelOutsidePolygon" : true,
            "canRemoveOverlappingLabel" : true,
