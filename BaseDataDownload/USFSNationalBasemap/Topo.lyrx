          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "var label_text = $feature.SITE_NAME\n\nvar WordsToDelete = [' (WBR)',' VOLUNTEER VILLAGE',' VOLUNTEER CAMP',' (D51)',' (CAMPGROUND & PICNIC SITE)',' CAMPGROUND, GROUP CAMPGROUND & TRAILHEAD',' CAMPGROUND & PICNIC', ' CAMPGROUND AND BOATING SITE', ' CG, TH, PA',' CG, TH, COMPLEX','/OHV STAGING AREA',' CAMPGROUND AREA',' CAMPGROUND & DAY USE AREA','CAMPGROUND & GROUP PICNIC AREA',' CAMPGROUND / TRAILHEAD',' (CAMPGROUND & TRAILHEAD)',' TENT(FAMILY CG)',' & DAY USE',' (CAMPGROUND & BOATING)',' (FAMILY CG)',' CAMPGROUND AND PICNIC AREA',' CAMPGROUND AND PICNIC',' CAMPGROUND AND GROUP CAMPGROUND','CAMPGROUND & DAY USE AREA',' (CAMPGROUND & TRAILHEADS)',' CAMPGROUND AND TRAILHEADS','CAMPGROUND & TRAILHEAD','CAMPGROUND/TRAILHEAD','CAMPGROUND AND TRAILHEAD','TRAILHEAD & CAMPGROUND','TRAILHEAD AND CAMPGROUND','(TRAILHEAD AND CAMPGROUND)',' BOAT RAMP & CAMPGROUND','CAMPGROUND & BOAT RAMP','CAMPGROUND & GROUP AREA','DISPERSED CAMPGROUND','RUSTIC CAMPGROUND','TENT CAMPGROUND',' CAMPGROUND COMPLEX','ATV CAMPGROUND','ORV CAMPGROUND','EQUESTRIAN CAMPGROUND',' EQUESTRIAN','(FAMILY CAMPGROUND)','FAMILY CAMPGROUND',' (CAMPGROUND)','BOAT ACCESS CAMPGROUND)','CAMPGROUNDS',' - CAMPGROUND',' CAMPGOUND',' CAMPGROUND','CAMGROUND','CAMP GROUND',' BOAT TO','CAMP AREA','OVERFLOW CAMPING','HUNT CAMP & TRAILHEAD','HUNT CAMP',' HUNTER CAMP',' HUNTER','OHV CAMP','RV CAMP','DISPERSED CAMP','BACKCOUNTRY CAMPSITES','ROADSIDE CAMPSITES','FOREST CAMP','OHV TRAILHEAD AND CAMP',' (TRAILHEAD)','OHV STAGING AREA','TRAILHEAD AND CAMPING AREA',' CAMPING AREA','PRIMITIVE CAMP','PRIMITIVE','HORSE CAMP','CANOE CAMP','CANOE','TRAIL CAMP','GROUP HORSE CAMP','GROUP CAMPING','GROUP CAMP','(GROUP CG)','ORGANIZATIONAL CAMP',' HIKER/BIKER CAMP',' CAMPSITES',' CAMPSITE',' CAMP','GROUP CAMPGROUNDS','GROUP AREA','GROUP USE SITE','GROUP USE CG','GROUP USE','GROUP SITES','(GROUP)','GROUP',' SHELTER & TENT AREA',' & TENT AREA',' SHELTER & TENT PLATFORMS',' TENT AREA',' SHELTER','BACKCOUNTRY SITE','HISTORIC SITE','DISPERSED SITES','DISPERSED AREA','DISPERSED CG','DEVELOPED SITE',' RECREATIONAL AREA','REC SITE','TENTSITE','TENT SITE','DESIGNATED DISPERSED SITE','SITES',' SITE',' - ENT','CG &DAY USE AREA',' CG - NAC','CG-F FREC LIC',' (CG-F)','STATE PARK CG','BACKPACKING CG',' BOAT CG','BACKPACKER CG','HIKE-IN C.G.',' -NEW',' CG-F',' CG & TH',' CG-G','(FAMILY CG.)','FAMILY CG.','FAMILY CG','(NEW)CG',' CG AND PICNIC',' CG/TRHD',' CG, TH, BL, IS',' CG, TH',' CG, BL',' CG, GS',' CG, IS',' - CG',' CG',' C.G.',' CUA',' & TH','RECREATION COMPLEX','RECREATION AREA','REC. AREA','REC.AREA','REC AREA',' REST AREA','COMPLEX','WALK-IN','-WALK IN','WALKIN','BOAT-IN','BOAT IN',' GCG',' G.C.G.','FAMILY','OHV','BOATING','R.V.','ATV','DISPERSED','ACCESS',' TENT',' OVERFLOW',' (EAST FORK-BLACK RIVER',' & BUTCHER KNIFE TRAILHEAD',' 4X4',' (NEAR SILVER BEACH)',' (NEAR HEADWATERS)',' RV PARK',' DESIGNATED',' AND RIMROCK BOAT LAUNCH','QUEMADO LAKE - ',' RUA ',' & TOWER LOOP TRAILHEAD']\n\nfor (var i in WordsToDelete){\n  label_text = Replace(label_text, WordsToDelete[i],'');\n}\nif (Find(' (PALOUSE)', label_text) != -1){label_text = Replace(label_text, ' (PALOUSE)','PALOUSE')}\nif (Find('CRANBERRY RUA', label_text) != -1){label_text = Replace(label_text, 'CRANBERRY RUA','CRANBERRY')}\nif (Find('COEUR DALENE', label_text) != -1){label_text = Replace(label_text, 'COEUR DALENE',\"COEUR D'ALENE\")}\nif (Find('SOUTH FORK REC', label_text) != -1){label_text = Replace(label_text, 'SOUTH FORK REC','SOUTH FORK')}\nif (Find('PASS CREEK ANNEX', label_text) != -1){label_text = Replace(label_text, 'PASS CREEK ANNEX','PASS CREEK')}\nif (Find('GREEN SPRINGS TH', label_text) != -1){label_text = Replace(label_text, 'GREEN SPRINGS TH','GREEN SPRINGS')}\nif (Find('CRUCES BASIN TH', label_text) != -1){label_text = Replace(label_text, 'CRUCES BASIN TH', 'CRUCES BASIN');\n}\nIf(Right(label_text, 3) == ' CG'){\n  label_text = Left(label_text, Count(label_text)-3)\n}\nreturn label_text\n",
