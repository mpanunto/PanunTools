        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "var label_text = $feature.fet_name\n\nvar WordsToDelete = [' Cross Country Ski Trailhead',' Cross Country Ski Trail Head',' River Access Trail Head',' Entrance OHV Trail Head',' Motorized Trail Head',' Bouldering Area Trailhead',' Climbing Area Trailhead',' Shelter Trailhead',' Railroad Grade Trailhead',' Pack Stock Trail Head',' Hiking and Mountain Bike Trail',' Mountain Bike Trailhead',' Mountain Bike Trail System',' Mountain Bike Trail Head',' Mountain Bike Trail',' Bike Trail',' Fishing Trail Head',' Hiking Trail',' Campground Trail Head',' Dispersed Trailhead',' TRAILHEAD SITE',' OFF HIGHWAY VEHICLE AREA',' OHV TRAILHEAD',' OHV Trailhead',' OHV Trail Head','Trailhead / ',' TRAILHEADS',' TRAILHEAD',' Trailhead',' trailhead',' Trail Head',' Trail System',' TRAILS',' Trails',' Trail',' OHV Staging Area',' OHV Open Area',' Boat Ramp',' Fishing Access',' Recreation Site',' Rec Site','Animas City Mountain - ',' - Cliffs Segment',' - Connector Segment','Grandview - ',' (State Parks)',' Childrens Discovery','M 59 ','Monolith Gardens TH - ','Muddy Mountain ','North Bank Habitat Management Area - ',' (18 Road)',' Wilderness Access',' Campground']\n\nfor (var i in WordsToDelete){\n  label_text = Replace(label_text, WordsToDelete[i],'');\n}\nif (Find('Coal CanyonTrailhead', label_text) != -1){label_text = Replace(label_text, 'Coal CanyonTrailhead', 'Coal Canyon');}\nif (Find('Jones CanyonTrailhead', label_text) != -1){label_text = Replace(label_text, 'Jones CanyonTrailhead', 'Jones Canyon');}\nif (Find('Rapid CreekTrailhead', label_text) != -1){label_text = Replace(label_text, 'Rapid CreekTrailhead', 'Rapid Creek');}\nif (Find('Shirley Mountains Mountain Biking', label_text) != -1){label_text = Replace(label_text, 'Shirley Mountains Mountain Biking', 'Shirley Mountains');}\nif (Find('River Mountains Equestrian', label_text) != -1){label_text = Replace(label_text, 'River Mountains Equestrian', 'River Mountains');}\nif (Find('Fraser River Access', label_text) != -1){label_text = Replace(label_text, 'Fraser River Access', 'Fraser River');}\nif (Find('Trail Head', label_text) != -1){label_text = Replace(label_text, 'Trail Head', '');\n}\nreturn Upper(label_text)",
