        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "var label_text = $feature.fet_name\n\nvar WordsToDelete = [' Hostsite',' Host Site',' Boat-In Campsite',' Campsites',' Campsite',' Campground',' RECREATION/TRAILHEAD SITE',' Recreation Site',' RECREATION SITE',' RECREATION AREA',' Recreation Area',' TRAILHEAD',' ELK VIEWING AREA -',' Wildlife Area']\n\nfor (var i in WordsToDelete){\n  label_text = Replace(label_text, WordsToDelete[i],'');\n}\n\nif (Find('Elkhorn Beach 1', label_text) != -1){label_text = Replace(label_text, 'Elkhorn Beach 1', 'Elkhorn Beach');}\nif (Find('Elkhorn Beach 2', label_text) != -1){label_text = Replace(label_text, 'Elkhorn Beach 2', 'Elkhorn Beach');}\nif (Find('Green River Access Site 11 1', label_text) != -1){label_text = Replace(label_text, 'Green River Access Site 11 1', 'Green River');}\nif (Find('Green River Access Site 2 1', label_text) != -1){label_text = Replace(label_text, 'Green River Access Site 2 1', 'Green River');}\nif (Find('Green River Access Site 3 1', label_text) != -1){label_text = Replace(label_text, 'Green River Access Site 3 1', 'Green River');}\nif (Find('Green River Access Site 4 1', label_text) != -1){label_text = Replace(label_text, 'Green River Access Site 4 1', 'Green River');}\nif (Find('Green River Access Site 5 1', label_text) != -1){label_text = Replace(label_text, 'Green River Access Site 5 1', 'Green River');}\nif (Find('Green River Access Site 7 2', label_text) != -1){label_text = Replace(label_text, 'Green River Access Site 7 2', 'Green River');}\nif (Find('Green River Access Site 8 1', label_text) != -1){label_text = Replace(label_text, 'Green River Access Site 8 1', 'Green River');}\nif (Find('Green River Access Site 9 2', label_text) != -1){label_text = Replace(label_text, 'Green River Access Site 9 2', 'Green River');}\nif (Find('Onion Valley Reservoir #7', label_text) != -1){label_text = Replace(label_text, 'Onion Valley Reservoir #7', 'Onion Valley Reservoir');}\nif (Find('Porter Springs #1', label_text) != -1){label_text = Replace(label_text, 'Porter Springs #1', 'Porter Springs');}\nif (Find('Soldier Meadows  #1', label_text) != -1){label_text = Replace(label_text, 'Soldier Meadows  #1', 'Soldier Meadows');}\nif (Find('Water Canyon #10', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #10', '');}\nif (Find('Water Canyon #1', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #1', '');}\nif (Find('Water Canyon #2', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #2', '');}\nif (Find('Water Canyon #3', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #3', '');}\nif (Find('Water Canyon #4', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #4', '');}\nif (Find('Water Canyon #5', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #5', 'Water Canyon');}\nif (Find('Water Canyon #6', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #6', '');}\nif (Find('Water Canyon #7', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #7', '');}\nif (Find('Water Canyon #8', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #8', '');}\nif (Find('Water Canyon #9', label_text) != -1){label_text = Replace(label_text, 'Water Canyon #9', '');}\n\nreturn Upper(label_text)\n\n\n",
