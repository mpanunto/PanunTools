        "type" : "CIMFeatureTable",
        "definitionExpression" : "route_status IN ('EX - EXISTING')\r\n\nAND NOT SYSTEM IN ('FDT - FOREST DEVELOPMENT TRAIL', 'NOT - NOT NEEDED', 'TMP - TEMPORARY', 'UND - UNDETERMINED', 'I - INTERSTATE HIGHWAY' , 'US - US HIGHWAY OR ROUTE', 'SH - STATE HIGHWAY') \r\n\nAND NOT ((route_status = 'EX - EXISTING') AND (system = 'NFSR - NATIONAL FOREST SYSTEM ROAD' OR system = 'P - PRIVATE') AND (jurisdiction = 'P - PRIVATE' OR jurisdiction = 'FS - FOREST SERVICE') AND ((symbol = 0) OR (symbol IS NULL AND seasonal IS NULL)))\r\n\nAND NOT ((system = 'NFSR - NATIONAL FOREST SYSTEM ROAD') AND (jurisdiction = 'FS - FOREST SERVICE') AND (oper_maint_level = '1 - BASIC CUSTODIAL CARE (CLOSED)'))\r\n\nAND NOT ( jurisdiction IN ( 'P - BIG SKY LUMBER' , 'P - BN' , 'P - BURLINGTON NORTHERN' , 'P - PC' , 'P - PLUM CREEK LUMBER CO' , 'P - REVETT' , 'P - STIMSON' , 'P - STZ' , 'P - WEYERHAEUSER', 'OFS - FLATHEAD NF', 'OFS - KOOTENAI NF', 'OFS - BEAVERHEAD DEERLODGE NF', 'OFS - BITTERROOT NF', 'OFS - CLEARWATER NF', 'OFS - GALLATIN NF', 'OFS - HELENA NF', 'OFS - IDAHO PANHANDLE NF', 'OFS - LEWIS AND CLARK NF', 'OFS - LOLO NF', 'OFS - REGION 6', 'OFS - SIERRA NF' ))\r\n\nOR \r\n\n((route_status IN ('EX - EXISTING') and applies_to IS NOT NULL))",
