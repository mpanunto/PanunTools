ALK-IN',' -WALK IN',' WALKIN',' BOAT-IN',' BOAT IN',' GCG',' G.C.G.',' FAMILY',' OHV',' BOATING',' R.V.',' ATV',' DISPERSED',' ACCESS']\n\nfor(var i in WordsToDelete){\n    label_text = Replace(label_text, WordsToDelete[i],'');\n}\n\nIf(Right(label_text, 3) == ' HC'){\n    label_text = Left(label_text, Count(label_text)-3)\n}\nreturn label_text",
