        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "var label_text = $feature.fet_name\n\nvar WordsToDelete = [' Campground',' Shoreline Campsite',' Campsite','Campsite','Camp Site','Camp Stie','Historic Recreation Area',' Recreation Site',' Dispersed Area',' County Park','Boater Park','Senator Wash Reservoir ',' at CJ Strike Reservoir',' LTVA',' CG']\nfor (var i in WordsToDelete){\n  label_text = Replace(label_text, WordsToDelete[i],'');\n}\nif (Find('Bass Bay 1', label_text) != -1){label_text = Replace(label_text, 'Bass Bay 1', 'Bass Bay');}\nif (Find('Bighorn Point 1', label_text) != -1){label_text = Replace(label_text, 'Bighorn Point 1', 'Bighorn Point');}\nif (Find('Bill Williams 1', label_text) != -1){label_text = Replace(label_text, 'Bill Williams 1', 'Bill Williams');}\nif (Find('Bill Williams 4', label_text) != -1){label_text = Replace(label_text, 'Bill Williams 4', 'Bill Williams');}\nif (Find('Blind Island 1', label_text) != -1){label_text = Replace(label_text, 'Blind Island 1', 'Blind Island');}\nif (Find('BLM Camp 1', label_text) != -1){label_text = Replace(label_text, 'BLM Camp 1', 'BLM Camp');}\nif (Find('Bluebird 1', label_text) != -1){label_text = Replace(label_text, 'Bluebird 1', 'Bluebird');}\nif (Find('Coyote Cove 1', label_text) != -1){label_text = Replace(label_text, 'Coyote Cove 1', 'Coyote Cove');}\nif (Find('Coyote Cove 2', label_text) != -1){label_text = Replace(label_text, 'Coyote Cove 2', 'Coyote Cove');}\nif (Find('Disneyland 1', label_text) != -1){label_text = Replace(label_text, 'Disneyland 1', 'Disneyland');}\nif (Find('Echo Cove 2', label_text) != -1){label_text = Replace(label_text, 'Echo Cove 2', 'Echo Cove');}\nif (Find('Friendly Isle 1', label_text) != -1){label_text = Replace(label_text, 'Friendly Isle 1', 'Friendly Isle');}\nif (Find('Gnat Keys 1', label_text) != -1){label_text = Replace(label_text, 'Gnat Keys 1', 'Gnat Keys');}\nif (Find('Gnat Keys 4', label_text) != -1){label_text = Replace(label_text, 'Gnat Keys 4', 'Gnat Keys');}\nif (Find('Goose Bay 1', label_text) != -1){label_text = Replace(label_text, 'Goose Bay 1', 'Goose Bay');}\nif (Find('Hi Isle 10', label_text) != -1){label_text = Replace(label_text, 'Hi Isle 10', 'Hi Isle');}\nif (Find('Hum Hum Sound 2', label_text) != -1){label_text = Replace(label_text, 'Hum Hum Sound 2', 'Hum Hum Sound');}\nif (Find('Larned Landling 1', label_text) != -1){label_text = Replace(label_text, 'Larned Landling 1', 'Larned Landing');}\nif (Find('Mallard Cove 5', label_text) != -1){label_text = Replace(label_text, 'Mallard Cove 5', 'Mallard Cove');}\nif (Find('Patos Island 1', label_text) != -1){label_text = Replace(label_text, 'Patos Island 1', 'Patos Island');}\nif (Find('Pilot Rock 2', label_text) != -1){label_text = Replace(label_text, 'Pilot Rock 2', 'Pilot Rock');}\nif (Find('Road Runner 2', label_text) != -1){label_text = Replace(label_text, 'Road Runner 2', 'Road Runner');}\nif (Find('Rocky Landing 2', label_text) != -1){label_text = Replace(label_text, 'Rocky Landing 2', 'Rocky Landing');}\nif (Find('Sandy Isle 2', label_text) != -1){label_text = Replace(label_text, 'Sandy Isle 2', 'Sandy Isle');}\nif (Find('Satellite Cove 1', label_text) != -1){label_text = Replace(label_text, 'Satellite Cove 1', 'Satellite Cove');}\nif (Find('South Shore Site', label_text) != -1){label_text = Replace(label_text, 'South Shore Site', 'South Shore');}\nif (Find('Standard Wash 4', label_text) != -1){label_text = Replace(label_text, 'Standard Wash 4', 'Standard Wash');}\nif (Find('Steamboat Cove 1', label_text) != -1){label_text = Replace(label_text, 'Steamboat Cove 1', 'Steamboat Cove');}\nif (Find(\"Whyte's Retreat 1\", label_text) != -1){label_text = Replace(label_text, \"Whyte's Retreat 1\", \"Whyte's Retreat\");}\nif (Find('Wren Cove 3', label_text) != -1){label_text = Replace(label_text, 'Wren Cove 3', 'Wren Cove');}\n\nreturn Upper(label_text)",
