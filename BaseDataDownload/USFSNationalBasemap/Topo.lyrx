        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "var label_text = $feature.SITE_NAME\n\nvar WordsToDelete = [' W71',' M81A',' M73',' M79',' M89',' M107',' M111',' M121',' M129',' (STORE AREA)',' W32',' W49',' W5',' W84',' W87',' W88',' W8',' W9',' W10',' W18',' W21',' W24',' W67',' D43',' D50',' D62',' M25',' B1',' B6',' B29A',' B37A',' 4 C30',' C21',' C32',' C40',' C43',' - CC#81',' BOAT 1',' BOAT 2',' BUOY',' COMMERCIAL / PUBLIC',' TAKE-OUT #1/2',' TAKE-OUT #3',' LOT 13', ' COMMERCIAL', ' BEACHING AREA/OBSV DECK', ' DAM AREA','(NORWAY BEACH REC AREA)', ' CCC', '/MAMMOTH FISHING',' CANOE PUT IN', ' CANOE & OHT TRAILHEAD', ' FERRY CROSSING',' (BOATRAMP)',' BOAT RAMP, 2/2', ' BOAT LAUNCH AND PICNIC SITE',' - LAKE OF EGYPT',' UNDEVELOPED', ' RAFT TAKE-OUT', ' REST AREA', ' BOATING/LAUNCH SITE', 'BOAT RAMP/DAY USE', ' HUNT CAMP & BOAT RAMP', '-BOAT RAMP', 'BOAT DOCKS', 'BOAT DOCK', 'BOAT LAUNCH COMPLEX', 'BOAT LAUNCH AREA', 'BOAT LAUNCH/TRAILHEAD', 'BOAT LAUNCH', 'BOAT LANDING',' CANOE LANDING', 'CANOE LAUNCH',' RAFTING PUT IN', 'RAFT LAUNCH', 'RAFT SITE', ' RAFT', 'CARRY DOWN', 'PUT-IN/TAKE-OUT', '(PUT-IN,TAKE-OUT)', '(PUT-IN)', 'CARRYIN ACCESS', 'CARRY-IN', 'CARRY IN', 'BOATER TAKEOUT', '(TAKE-OUT)', 'TAKE-OUT',' TAKE OUT', 'TAKEOUT', 'FLOATBOAT ACCESS', 'ATV BOAT ACCESS',' BOAT ACCESS -CC#11',' #1', 'BOAT ACCESS', '/BOATING/PICNIC/TRHD', ' BOATING SITE', ' BOAT SITE', ' BOATING AREA', ' BOATING/PICNIC', ' BOATING AND PICNIC', 'BOATING AND DAY USE', ' BOATING',' (BOATING)', 'BOAT RAMP', ' BOAT', ' DAY USE AREA', ' DISPERSED AREA', ' DISPERSED', ' DAY USE', ' @', ' CANOE', ' KAYAK TRAIL', ' KAYAK LAUNCH', ' RIVER LAUNCH SITE', ' RIVER LAUNCH', ' CANOE & OHT TRAILHEAD', ' RIVER ACCESS SITE', ' RIVER ACCESS PARKING', 'ROAD CANOE ACCESS', ' RIVER ACCESS', ' CANOE ACCESS', ' PICNIC AND', ' RAFTING PUT IT', ' RAFT TAKE-OUT', ' RAFTING TAKE OUT', ' RAFTERS', 'LAUNCHING RAMP', 'RAMP', 'MARINA & STORE', 'MARINA', 'ACCESS', 'LAUNCH SITE', 'RECREATION AREA CAMPSITE AND', ' RECREATION AREA', ' AND BIKE TRAILHEAD', 'REC SITE', ' BS', ' CG', 'ANGLER PARKING', ' LAUNCH', ' REST STOP',' DOCK',' PUT-IN',' AND PICNIC',' #2',' #3',' MILE 16.7']\n \nfor (var i in WordsToDelete){\n  label_text = Replace(label_text, WordsToDelete[i],'');\n}\n\n// Check for text that needs to be replaced with something else\nif (Find('MILE RA', label_text) != -1){label_text = Replace(label_text, 'MILE RA', 'MILE')}\nif (Find('WOODS CANYON LAKE AREA', label_text) != -1){label_text = Replace(label_text, 'WOODS CANYON LAKE AREA', 'WOODS CANYON LAKE')}\nif (Find('13 C46', label_text) != -1){label_text = Replace(label_text, '13 C46', 'THIRTEEN')}\nif (Find('HWY191-105 MM44.3', label_text) != -1){label_text = Replace(label_text, 'HWY191-105 MM44.3','HWY 191')}\nif (Find('HWY191-23', label_text) != -1){label_text = Replace(label_text, 'HWY191-23','HWY 191')}\nif (Find('HWY191-41', label_text) != -1){label_text = Replace(label_text, 'HWY191-41','HWY 191')}\nif (Find('HWY191-50 LAVA', label_text) != -1){label_text = Replace(label_text, 'HWY191-50 LAVA','HWY 191 - LAVA')}\nif (Find('HWY191-77 MM53.6', label_text) != -1){label_text = Replace(label_text, 'HWY191-77 MM53.6','HWY 191')}\nif (Find('HWY191-49 MM58.1 GREEK CK PULLOUT', label_text) != -1){label_text = Replace(label_text, 'HWY191-49 MM58.1 GREEK CK PULLOUT','HWY 191 - GREEK CREEK')}\nif (Find('FISH CREEK RA', label_text) != -1){label_text = Replace(label_text, 'FISH CREEK RA', 'FISH CREEK')}\nif (Find('S.B.', label_text) != -1){label_text = Replace(label_text, 'S.B.', 'SUGAR BAY')}\nif (Find(' RESV', label_text) != -1){label_text = Replace(label_text, ' RESV', ' RESERVOIR')}\nif (Find('T.L. BOATING', label_text) != -1){label_text = Replace(label_text, 'T.L.  BOATING', 'TWIN LAKES')}\nif (Find('T.B. BOATING', label_text) != -1){label_text = Replace(label_text, 'T.B. BOATING', 'TAYLOR BAY')}\nif (Find('S.B. BOATING', label_text) != -1){label_text = Replace(label_text, 'S.B. BOATING', 'SUGAR BAY')}\nif (Find('R.H. BOATING', label_text) != -1){label_text = Replace(label_text, 'R.H. BOATING', 'REDD HOLLOW')}\nif (Find('N.B. BOATING', label_text) != -1){label_text = Replace(label_text, 'N.B. BOATING', 'NICKELL BRANCH')}\nif (Find('C.B. BOATING', label_text) != -1){label_text = Replace(label_text, 'C.B. BOATING', 'CRAVENS BAY')}\nif (Find('B.L. BOATING', label_text) != -1){label_text = Replace(label_text, 'B.L. BOATING', 'BOSWELL LANDING')}\nif (Find('B.F. BOATING', label_text) != -1){label_text = Replace(label_text, 'B.F. BOATING', 'BIRMINGHAM FERRY')}\nif (Find('SAGANAGA LK', label_text) != -1){label_text = Replace(label_text, 'SAGANAGA LK', 'SAGANAGA LAKE')}\nif (Find('SAG. LAKE COUNTY', label_text) != -1){label_text = Replace(label_text, 'SAG. LAKE COUNTY', 'SAGANAGA LAKE')}\nif (Find(' CK PULLOUT', label_text) != -1){label_text = Replace(label_text, ' CK PULLOUT', ' CREEK');\n}\nIf(Right(label_text, 3) == ' BL'){\n  label_text = Left(label_text, Count(label_text)-3)\n}\nreturn label_text",
