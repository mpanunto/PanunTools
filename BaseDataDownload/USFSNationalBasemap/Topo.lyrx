        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "var label_text = $feature.name\nif (Find('North Carolina', label_text) != -1){label_text = Replace(label_text, 'North Carolina', 'N.C.')}\nif (Find('North Dakota', label_text) != -1){label_text = Replace(label_text, 'North Dakota', 'N.D.')}\nif (Find('South Carolina', label_text) != -1){label_text = Replace(label_text, 'South Carolina', 'S.C')}\nif (Find('South Dakota', label_text) != -1){label_text = Replace(label_text, 'South Dakota', 'S.D.')}\nif (Find('West Virginia', label_text) != -1){label_text = Replace(label_text, 'West Virginia', 'W.Va.')}\nif (Find('United States', label_text) != -1){label_text = Replace(label_text, 'United States', 'U.S.')}\nif (Find('the District of Columbia', label_text) != -1){label_text = Replace(label_text, 'the District of Columbia', 'D.C.')}\nif (Find('District of Columbia', label_text) != -1){label_text = Replace(label_text, 'District of Columbia', 'D.C')}\nif (Find('Central District', label_text) != -1){label_text = Replace(label_text, 'Central District', 'C.D.')}\nif (Find('Eastern District', label_text) != -1){label_text = Replace(label_text, 'Eastern District', 'E.D.')}\nif (Find('Middle District', label_text) != -1){label_text = Replace(label_text, 'Middle District', 'M.D.')}\nif (Find('Northern District', label_text) != -1){label_text = Replace(label_text, 'Northern District', 'N.D.')}\nif (Find('Southern District', label_text) != -1){label_text = Replace(label_text, 'Southern District', 'S.D.')}\nif (Find('Western District', label_text) != -1){label_text = Replace(label_text, 'Western District', 'W.D.')}\nif (Find('Southern', label_text) != -1){label_text = Replace(label_text, 'Southern', 'S.')}\nif (Find('Southeast', label_text) != -1){label_text = Replace(label_text, 'Southeast', 'S.E.')}\nif (Find('Southwest', label_text) != -1){label_text = Replace(label_text, 'Southwest', 'S.W.')}\nif (Find('South', label_text) != -1){label_text = Replace(label_text, 'South', 'S.')}\nif (Find('Northern', label_text) != -1){label_text = Replace(label_text, 'Northern', 'N.')}\nif (Find('Northeast', label_text) != -1){label_text = Replace(label_text, 'Northeast', 'N.E.')}\nif (Find('Northwest', label_text) != -1){label_text = Replace(label_text, 'Northwest', 'N.W.')}\nif (Find('North', label_text) != -1){label_text = Replace(label_text, 'North', 'N.')}\nif (Find('Western', label_text) != -1){label_text = Replace(label_text, 'Western', 'W.')}\nif (Find('West', label_text) != -1){label_text = Replace(label_text, 'West', 'W.')}\nif (Find('Eastern', label_text) != -1){label_text = Replace(label_text, 'Eastern', 'E.')}\nif (Find('East', label_text) != -1){label_text = Replace(label_text, 'East', 'E.')}\nif (Find('Court of Appeals', label_text) != -1){label_text = Replace(label_text, 'Court of Appeals', 'Ct. App.')}\nif (Find('Courts of Appeal', label_text) != -1){label_text = Replace(label_text, 'Courts of Appeal', 'Cts. App.')}\nif (Find('Common Pleas', label_text) != -1){label_text = Replace(label_text, 'Common Pleas', 'C.P.')}\nif (Find('Courthouse', label_text) != -1){label_text = Replace(label_text, 'Courthouse', 'CH')}\nif (Find('Court House', label_text) != -1){label_text = Replace(label_text, 'Court House', 'CH')}\nif (Find('Courts', label_text) != -1){label_text = Replace(label_text, 'Courts', 'Cts')}\nif (Find('Court', label_text) != -1){label_text = Replace(label_text, 'Court', 'Ct.')}\nif (Find('Superior', label_text) != -1){label_text = Replace(label_text, 'Superior', 'Super.')}\nif (Find('District', label_text) != -1){label_text = Replace(label_text, 'District', 'Dist.')}\nif (Find('Divisions', label_text) != -1){label_text = Replace(label_text, 'Divisions', 'Div.')}\nif (Find('Division', label_text) != -1){label_text = Replace(label_text, 'Division', 'Div.')}\nif (Find('Judicial', label_text) != -1){label_text = Replace(label_text, 'Judicial', 'Jud.')}\nif (Find('Governmental', label_text) != -1){label_text = Replace(label_text, 'Governmental', 'Govt.')}\nif (Find('Government', label_text) != -1){label_text = Replace(label_text, 'Government', 'Govt.')}\nif (Find(\"Regional\", label_text) != -1){label_text = Replace(label_text, \"Regional\", \"Reg'l.\")}\nif (Find('Annex', label_text) != -1){label_text = Replace(label_text, 'Annex', 'Anx.')}\nif (Find('Center', label_text) != -1){label_text = Replace(label_text, 'Center', 'Cent.')}\nif (Find('Building', label_text) != -1){label_text = Replace(label_text, 'Building', 'Bldg.')}\nif (Find('Family', label_text) != -1){label_text = Replace(label_text, 'Family', 'Fam.')}\nif (Find('Chancery', label_text) != -1){label_text = Replace(label_text, 'Chancery', 'Ch.')}\nif (Find('Criminal', label_text) != -1){label_text = Replace(label_text, 'Criminal', 'Crim.')}\nif (Find('Federal', label_text) != -1){label_text = Replace(label_text, 'Federal', 'Fed.')}\nif (Find('First', label_text) != -1){label_text = Replace(label_text, 'First', '1st')}\nif (Find('Second', label_text) != -1){label_text = Replace(label_text, 'Second', '2d')}\nif (Find('Third', label_text) != -1){label_text = Replace(label_text, 'Third', '3d')}\nif (Find('Circuit', label_text) != -1){label_text = Replace(label_text, 'Circuit', 'Cir.')}\nif (Find('Civil', label_text) != -1){label_text = Replace(label_text, 'Civil', 'Civ.')}\nif (Find('Magistrates', label_text) != -1){label_text = Replace(label_text, 'Magistrates', 'Magis.')}\nif (Find('Magistrate', label_text) != -1){label_text = Replace(label_text, 'Magistrate', 'Magis.')}\nif (Find('Complex', label_text) != -1){label_text = Replace(label_text, 'Complex', 'Comp.')}\nif (Find('Alabama', label_text) != -1){label_text = Replace(label_text, 'Alabama', 'Ala.')}\nif (Find('Connecticut', label_text) != -1){label_text = Replace(label_text, 'Connecticut', 'Conn.')}\nif (Find('Arizona', label_text) != -1){label_text = Replace(label_text, 'Arizona', 'Ariz.')}\nif (Find('Arkansas', label_text) != -1){label_text = Replace(label_text, 'Arkansas', 'Ark.')}\nif (Find('California', la