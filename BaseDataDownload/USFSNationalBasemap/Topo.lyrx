          "expression" : "def FindLabel ( [NAMELSAD] ):\n  a = [NAMELSAD]\n  if 'city' in a: \n    cleanA = a.rsplit(' city')[0]  \n    return cleanA\n  if 'CDP' in a: \n    cleanA = a.rsplit(' CDP')[0]  \n    return cleanA\n  if 'town' in a: \n    cleanA = a.rsplit(' town')[0]  \n    return cleanA\n  if 'village' in a: \n    cleanA = a.rsplit(' village')[0]  \n    return cleanA\n  if 'comunidad' in a: \n    cleanA = a.rsplit(' comunidad')[0]  \n    return cleanA\n  if 'borough' in a: \n    cleanA = a.rsplit(' borough')[0]  \n    return cleanA\n",
