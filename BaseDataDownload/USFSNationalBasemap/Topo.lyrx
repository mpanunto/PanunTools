        {
          "type" : "CIMLabelClass",
          "expressionTitle" : "Custom",
          "expression" : "def FindLabel ( [poiname]  ):\n  import re\n  newlabel = re.sub(r\"\\([^()]*\\)\", \"\", [poiname]  )\n  S = newlabel.replace(\"Campground -\",\"\").replace(\"Campground\",\"\").replace(\"Camground\",\"\").replace(\"Campround\",\"\").replace(\"Campg\",\"\").replace(\"Camping Area\",\"\").replace(\"Horse Camp\",\"\").replace(\" Walk-in Tent\",\"\").replace(\" Walk-in\",\"\").replace(\" Boat-in Campsites\",\"\").replace(\" Boat-in\",\"\").replace(\" Group Camping Area\",\"\").replace(\" Group Camping Only\",\"\").replace(\" Group Camping\",\"\").replace(\"Group Camp\",\"\").replace(\" Group\",\"\").replace(\" State Recreation Site\",\"\")\n  S = S.upper()\n  return S",
