, label_text) != -1){label_text = Replace(label_text, 'New Hampshire', 'N.H.')}\nif (Find('New Jersey', label_text) != -1){label_text = Replace(label_text, 'New Jersey', 'N.J.')}\nif (Find('New Mexico', label_text) != -1){label_text = Replace(label_text, 'New Mexico', 'N.M.')}\nif (Find('New York', label_text) != -1){label_text = Replace(label_text, 'New York', 'N.Y.')}\nif (Find('Oklahoma', label_text) != -1){label_text = Replace(label_text, 'Oklahoma', 'Okla.')}\nif (Find('Oregon', label_text) != -1){label_text = Replace(label_text, 'Oregon', 'Or.')}\nif (Find('Pennsylvania', label_text) != -1){label_text = Replace(label_text, 'Pennsylvania', 'Pa.')}\nif (Find('Rhode Island', label_text) != -1){label_text = Replace(label_text, 'Rhode Island', 'R.I.')}\nif (Find('Tennessee', label_text) != -1){label_text = Replace(label_text, 'Tennessee', 'Tenn.')}\nif (Find('Texas', label_text) != -1){label_text = Replace(label_text, 'Texas', 'Tex.')}\nif (Find('Vermont', label_text) != -1){label_text = Replace(label_text, 'Vermont', 'Vt.')}\nif (Find('Virginia', label_text) != -1){label_text = Replace(label_text, 'Virginia', 'Va.')}\nif (Find('Washington', label_text) != -1){label_text = Replace(label_text, 'Washington', 'Wash.')}\nif (Find('Wisconsin', label_text) != -1){label_text = Replace(label_text, 'Wisconsin', 'Wis.')}\nif (Find('Wyoming', label_text) != -1){label_text = Replace(label_text, 'Wyoming', 'Wyo.')}\nif (Find(' 32 - 2 - 05', label_text) != -1){label_text = Replace(label_text, ' 32 - 2 - 05', '')}\nif (Find(' Number One - Toronto', label_text) != -1){label_text = Replace(label_text, ' Number One - Toronto', '')}\n\nreturn label_text",
