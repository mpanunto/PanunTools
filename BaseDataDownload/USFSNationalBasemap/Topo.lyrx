          "expression" : "var label_text = $feature.SITE_NAME\n\nif (Find(' SKI HUT', label_text) != -1){label_text = Replace(label_text, ' SKI HUT', '')}\nif (Find(' HUT', label_text) != -1){label_text = Replace(label_text, ' HUT', '')}\nif (Find(' SHELTER', label_text) != -1){label_text = Replace(label_text, ' SHELTER', '')}\nif (Find(' WARMING', label_text) != -1){label_text = Replace(label_text, ' WARMING', '')}\nif (Find(' WINTER', label_text) != -1){label_text = Replace(label_text, ' WINTER', '')}\nif (Find(' SNOW PLAY', label_text) != -1){label_text = Replace(label_text, ' SNOW PLAY', '')}\nif (Find(' TRAILHEAD &', label_text) != -1){label_text = Replace(label_text, ' TRAILHEAD &', '')}\nif (Find(' SNOPLAY', label_text) != -1){label_text = Replace(label_text, ' SNOPLAY', '')}\nif (Find(' SNO-PLAY', label_text) != -1){label_text = Replace(label_text, ' SNO-PLAY', '')}\nif (Find(' AREA', label_text) != -1){label_text = Replace(label_text, ' AREA', '')}\nif (Find(' REC SITE', label_text) != -1){label_text = Replace(label_text, ' REC SITE', '')}\nif (Find(' RECREATION SITE', label_text) != -1){label_text = Replace(label_text, ' RECREATION SITE', '')}\nif (Find(' TRAIL A-FRAME', label_text) != -1){label_text = Replace(label_text, ' TRAIL A-FRAME', '')}\nif (Find('CREEK 001', label_text) != -1){label_text = Replace(label_text, 'CREEK 001', 'CREEK')}\n\nreturn label_text",
