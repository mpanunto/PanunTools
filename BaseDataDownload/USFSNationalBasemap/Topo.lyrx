          "expression" : "var label_text = $feature.SITE_NAME\n\nvar delete_list = [' DAY USE, BL, IS',' DAY USE AREA - LOT #6',' DAY USE AND TRAILHEAD',' (OBSERVATION/TRAILHEAD/STAGING)',' AND PICNIC AREA',' (PICNIC & TRAILHEAD)',' PICNIC AND TRAILHEAD',' REC SITE, BL, IS',' GROUP RESERVATION SITE',' BOAT LAUNCH AND PINIC SITE',' DAY USE AND PICNIC AREA',' PICNIC (54)',' PICNIC, BOATING, TRAILHEAD, AND SNO-PARK',' PICNIC SITES',' PICNIC SITE',' PICNIC SHELTERS',' PICNIC SHELTER',' PICNIC/FISHING',' VIEW POINT / PICNIC AREA',' PICNIC AND PAVILION',' PICNIC AND BOAT LAUNCH',' PICNIC GROUNDS',' PICNIC GROUND',' PICNIC AREA AND TRAILHEAD',' DAY USE AND PICNIC AREA','-DAY USE AREA',' PICNIC USE','-PICNIC AREA',' PICNIC AREAS',' PICNIC AREA',' - PICNIC','PICNIC-F','PICNIC',' REST STOP',' REST AREA',' DISPERSED',' DISP AREA',' RECREATION SITE',' RECREATION AREA',' REC. AREA',' REC AREA','AREA COMPOSITE',' AREA',' FAMILY PG.',' PG & BOAT LAUNCH','GPA',' RESERVATION',' SITE',' BOAT LAUNCH AND',' REC',' DUA',' CG',' PG',' PS',' - TON',' INTERPRETIVE SITE','REC SITE, BL, IS','REC SITE',' HISTORIC SITE',' INTERPT. PARK',' RESERVATION SITE','& TRAILHEAD','DAY-USE AREA','DAY USE SITE','DAY USE OHV','DAY USE AREA','DAY USE,BL, IS','DAY USE','DAYUSE','DAY-USE',' GPG',' (FAMILY)',', SINGLE FAMILY',', FAMILY',' FAMILY','()','BOATING','GROUP USE','GROUP SITES','PAVILION NORDIC','GROUP',' ROADSIDE',' SWIMMING/',' & BOAT LAUNCH']\n\nfor(var i in delete_list){\n    label_text = Replace(label_text, delete_list[i],'');\n}\nif (Find('DIFFICULT DAY', label_text) != -1){label_text = Replace(label_text, 'DIFFICULT DAY','DIFFICULT')}\nif (Find('HISTORIC', label_text) != -1){label_text = Replace(label_text, 'HISTORIC','HISTORIC SITE')}\nif (Find('GATEWAY PARK NATURAL', label_text) != -1){label_text = Replace(label_text, 'GATEWAY PARK NATURAL','GATEWAY PARK NATURAL AREA')}\nif (Find('WAYSIDE REST', label_text) != -1){label_text = Replace(label_text, 'WAYSIDE REST','WAYSIDE')}\n\nIf(Right(label_text, 3) == ' PA'){\n  label_text = Left(label_text, Count(label_text)-3)\n}\n\nreturn label_text",
