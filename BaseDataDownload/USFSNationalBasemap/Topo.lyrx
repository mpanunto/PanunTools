        "definitionExpression" : "DES_TP IN ('NP', 'NSBV', 'NM', 'NLS', 'NRA', 'SW', 'NWR', 'WA', 'SREC', 'SCA', 'RMA', 'SP', 'TRIBL') AND NOT GIS_SRC IN ( 'USFS_ALP_S_USA.NFSLandUnit', 'USFS_ALP_S_USA.OtherNationalDesignatedArea', 'USFS_ALP_S_USA.OtherSurfaceRight', 'USFS_ALP_S_USA.ProclaimedForest_Grassland', 'USFS_ALP_S_USA.SpecialInterestManagementArea', 'USFS_ALP_S_USA.SurfaceOwnership', 'USFS_ALP_S_USA.Wilderness', 'USFS_ALP_S_USA.WildScenicRiver', 'USFS_ALP_S_USA.Withdrawal', 'USFS_S_USA.ROADLESSAREA_2_ID_CO''USFS_USFS Region 6, Columbia Gorge National Scenic Area', 'USFS_USVI_ProtectedAreas.shp' ,'Gila NF GIS Program') AND NOT (UNIT_NM = 'Gila Cliff Dwellings National Monument') AND NOT (LOC_NM = 'OC&E Woods Line State Trail')",
