        {
          "type" : "CIMLabelClass",
          "expression" : "def FindLabel ( [SITE_NAME] ):\n  import re\n  newlabel = re.sub(r\"\\([^()]*\\)\", \"\", [SITE_NAME])\n  if newlabel.endswith(\" CG\"):\n     S= newlabel.replace(\" CG\",\"\")\n     return S\n  else:\n     S=newlabel.replace(\"CAMPGROUND & GROUP PICNIC AREA\",\"\").replace(\"CAMPGROUND AND PICNIC\",\"\").replace(\"CAMPGROUND & DAY USE AREA\",\"\").replace(\"CAMPGROUND & TRAILHEAD\",\"\").replace(\"CAMPGROUND/TRAILHEAD\",\"\").replace(\"CAMPGROUND AND TRAILHEAD\",\"\").replace(\"TRAILHEAD & CAMPGROUND\",\"\").replace(\"TRAILHEAD AND CAMPGROUND\",\"\").replace(\"(TRAILHEAD AND CAMPGROUND)\",\"\").replace(\" BOAT RAMP & CAMPGROUND\",\"\").replace(\"CAMPGROUND & BOAT RAMP\",\"\").replace(\"CAMPGROUND & GROUP AREA\",\"\").replace(\"DISPERSED CAMPGROUND\",\"\").replace(\"RUSTIC CAMPGROUND\",\"\").replace(\"TENT CAMPGROUND\",\"\").replace(\" CAMPGROUND COMPLEX\",\"\").replace(\"ATV CAMPGROUND\",\"\").replace(\"ORV CAMPGROUND\",\"\").replace(\"EQUESTRIAN CAMPGROUND\",\"\").replace(\"(FAMILY CAMPGROUND)\",\"\").replace(\"FAMILY CAMPGROUND\",\"\").replace(\"BOAT ACCESS CAMPGROUND\",\"\").replace(\"CAMPGROUNDS\",\"\").replace(\" - CAMPGROUND\",\"\").replace(\"CAMPGROUND\",\"\").replace(\"CAMGROUND\",\"\").replace(\"CAMP GROUND\",\"\").replace(\"CAMP AREA\",\"\").replace(\"OVERFLOW CAMPING\",\"\").replace(\"HUNT CAMP & TRAILHEAD\",\"\").replace(\"HUNT CAMP\",\"\").replace(\" HUNTER CAMP\",\"\").replace(\" HUNTER\",\"\").replace(\"OHV CAMP\",\"\").replace(\"RV CAMP\",\"\").replace(\"DISPERSED CAMP\",\"\").replace(\"BACKCOUNTRY CAMPSITES\",\"\").replace(\"ROADSIDE CAMPSITES\",\"\").replace(\"FOREST CAMP\",\"\").replace(\"OHV TRAILHEAD AND CAMP\",\"\").replace(\"OHV STAGING AREA\",\"\").replace(\"TRAILHEAD AND CAMPING AREA\",\"\").replace(\" CAMPING AREA\",\"\").replace(\"PRIMITIVE CAMP\",\"\").replace(\"PRIMITIVE\",\"\").replace(\"HORSE CAMP\",\"\").replace(\"CANOE CAMP\",\"\").replace(\"CANOE\",\"\").replace(\"TRAIL CAMP\",\"\").replace(\"GROUP CAMP AND PICNIC ARE\",\"\").replace(\"GROUP HORSE CAMP\",\"\").replace(\"GROUP CAMPING\",\"\").replace(\"GROUP CAMP\",\"\").replace(\"(GROUP CG)\",\"\").replace(\"ORGANIZATIONAL CAMP\",\"\").replace(\" HIKER/BIKER CAMP\",\"\").replace(\" CAMPSITE\",\"\").replace(\" CAMP\",\"\").replace(\"GROUP CAMPGROUNDS\",\"\").replace(\"GROUP AREA\",\"\").replace(\"GROUP USE SITE\",\"\").replace(\"GROUP USE CG\",\"\").replace(\"GROUP USE\",\"\").replace(\"GROUP SITES\",\"\").replace(\"(GROUP)\",\"\").replace(\"GROUP\",\"\").replace(\" SHELTER & TENT AREA\",\"\").replace(\" SHELTER & TENT PLATFORMS\",\"\").replace(\" & TENT AREA\",\"\").replace(\" SHELTER\",\"\").replace(\"BACKCOUNTRY SITE\",\"\").replace(\"HISTORIC SITE\",\"\").replace(\"DISPERSED SITES\",\"\").replace(\"DISPERSED AREA\",\"\").replace(\"DISPERSED CG\",\"\").replace(\"DEVELOPED SITE\",\"\").replace(\"REC SITE,\",\"\").replace(\"TENTSITE\",\"\").replace(\"TENT SITE\",\"\").replace(\"DESIGNATED DISPERSED SITE\",\"\").replace(\"SITES\",\"\").replace(\" SITE\",\"\").replace(\" - ENT\",\"\").replace(\"CG &DAY USE AREA\",\"\").replace(\" CG - NAC\",\"\").replace(\"CG-F FREC LIC\",\"\").replace(\" (CG-F)\",\"\").replace(\"STATE PARK CG\",\"\").replace(\"BACKPACKING CG\",\"\").replace(\"BACKPACKER CG\",\"\").replace(\"HIKE-IN C.G.\",\"\").replace(\" CG-F\",\"\").replace(\" CG-G\",\"\").replace(\"(FAMILY CG.)\",\"\").replace(\"FAMILY CG.\",\"\").replace(\"FAMILY CG\",\"\").replace(\"(NEW)CG\",\"\").replace(\" CG AND PICNIC\",\"\").replace(\" CG/TRHD\",\"\").replace(\" CG, TH, BL, IS\",\"\").replace(\" CG, TH, PA\",\"\").replace(\" CG, TH\",\"\").replace(\" CG, BL\",\"\").replace(\" CG, GS\",\"\").replace(\" CG, IS\",\"\").replace(\" - CG\",\"\").replace(\" CG\",\"\").replace(\" C G\",\"\").replace(\" C.G.\",\"\").replace(\" CUA\",\"\").replace(\" & TH\",\"\").replace(\"RECREATION COMPLEX\",\"\").replace(\"RECREATION AREA\",\"\").replace(\"REC. AREA\",\"\").replace(\"REC.AREA\",\"\").replace(\"REC AREA\",\"\").replace(\" REST AREA\",\"\").replace(\"COMPLEX\",\"\").replace(\"WALK-IN\",\"\").replace(\"-WALK IN\",\"\").replace(\"WALKIN\",\"\").replace(\"BOAT-IN\",\"\").replace(\"BOAT IN\",\"\").replace(\" GCG\",\"\").replace(\" G.C.G.\",\"\").replace(\"FAMILY\",\"\").replace(\"OHV\",\"\").replace(\"BOATING\",\"\").replace(\"R.V.\",\"\").replace(\"ATV\",\"\").replace(\"DISPERSED\",\"\").replace(\"ACCESS\",\"\")\n     return S",
